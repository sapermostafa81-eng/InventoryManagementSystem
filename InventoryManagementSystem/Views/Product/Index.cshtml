@model IEnumerable<InventoryManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Add New Product
    </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Title</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Title
                </td>

                <td>
                    @item.Price
                </td>

                <td>
                    @item.Quantity
                </td>

                <td>
                    @item.Category?.Name
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.ProductId"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.ProductId"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.ProductId"
                       class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>